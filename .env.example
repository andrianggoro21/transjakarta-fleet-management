# ==============================================================================
# Environment Variables Example for Transjakarta Fleet Management
# ==============================================================================
# Salin file ini menjadi .env jika ingin mengubah konfigurasi default:
#   cp .env.example .env (Linux/macOS) atau copy .env.example .env (Windows)
# ==============================================================================

# Port PostgreSQL di host machine (berguna jika port 5432 lokal sudah terpakai)
POSTGRES_HOST_PORT=5432

# Port HTTP server Gin
HTTP_ADDR=:8080

# Koneksi Broker & Database (default internal Docker Compose network)
# Catatan: Jika menjalankan aplikasi Go langsung di host (di luar Docker),
# ganti hostname 'mosquitto', 'postgres', dan 'rabbitmq' menjadi 'localhost'.
MQTT_BROKER_URL=tcp://mosquitto:1883
DATABASE_URL=postgres://fleet:fleet@postgres:5432/fleet?sslmode=disable
RABBITMQ_URL=amqp://fleet:fleet@rabbitmq:5672/

# Titik pusat dan radius deteksi Geofence (default: Monas, Jakarta)
GEOFENCE_LAT=-6.1754
GEOFENCE_LON=106.8272
GEOFENCE_RADIUS_M=50

# Interval pengiriman data lokasi oleh mock publisher
PUBLISH_INTERVAL=2s

